# Database Configuration
POSTGRES_USER=smartmaint
POSTGRES_PASSWORD=smartmaint123
POSTGRES_DB=smartmaint_db
# Host port mapped to Postgres in docker-compose.yml (default there is 5433 unless you override POSTGRES_PORT)
POSTGRES_PORT=5433

# pgAdmin web UI (docker compose service `pgadmin`) — http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@smartmaint.dev
PGADMIN_DEFAULT_PASSWORD=smartmaint_pgadmin

# Docker Compose (backend in container): DATABASE_* are set in docker-compose.yml (host `postgres`, port 5432).
# Run migrations:  docker compose exec backend npm run migration:run
# Do NOT set DATABASE_SYNCHRONIZE=true (see docker-compose DATABASE_SYNCHRONIZE=false).
#
# Migrations from your PC (not inside container): use backend/.env with host + published port:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=smartmaint
# DATABASE_PASSWORD=smartmaint123
# DATABASE_NAME=smartmaint_db

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=3001
NODE_ENV=development
# Schema: use migrations only. Do NOT set DATABASE_SYNCHRONIZE=true (TypeORM will drop FKs/indexes from migrations).
# DATABASE_SYNCHRONIZE=false
# Optional: run pending migrations on API boot (usually run `cd backend && npm run migration:run` instead)
# DATABASE_RUN_MIGRATIONS=false
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Techo commandes (4 CSV ; — dossier avec article.csv, magasin.csv, order_lines.csv, data_plus.csv)
ORDER_TECHO_ENABLED=true
# Vide = backend/data/order-techo (ou ORDER_TECHO_DATA_DIR=/chemin/vers/data)
ORDER_TECHO_DATA_DIR=
CHAT_HISTORY_MAX_TURNS=80
ORDER_CONTEXT_TTL_MS=86400000

# AI Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# Techo: one Ollama call per message to route ticket lookup / action / create (no OpenRouter)
TICKET_INTENT_ROUTER=true
# Optional router-only model (defaults to OLLAMA_MODEL — use same Qwen to avoid extra pulls)
# OLLAMA_ROUTER_MODEL=qwen2.5:7b
# Auto-generate Techo conversation tab titles via Ollama (heuristic fallback always runs first)
THREAD_TITLE_LLM=true
OLLAMA_EMBED_MODEL=nomic-embed-text
# Hard cap for embed request payload sent to Ollama /api/embed.
OLLAMA_EMBED_MAX_CHARS=6000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Concurrent vision calls per inline batch (higher = faster, slightly more rate-limit risk).
PDF_VISION_CONCURRENCY=6

# Qdrant Vector DB
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
# Collection for manual chunks + retrieval (RagService default: manual_chunks)
QDRANT_COLLECTION=manual_chunks

# PDF ingestion (§1 — upload validation & storage)
# Directory for uploaded manuals (relative to backend process.cwd(), created if missing)
KNOWLEDGE_PDF_UPLOAD_DIR=uploads/knowledge-documents
# Max upload size in bytes (must match multer limit; default 30 MiB)
KNOWLEDGE_PDF_MAX_BYTES=31457280

# PDF upload gate (§2 — 3-tier relevance: heuristic → embedding → LLM)
# Tier 1: heuristic score thresholds (0–1)
GATE_TIER1_ACCEPT_ABOVE=0.75
GATE_TIER1_REJECT_BELOW=0.25
# Tier 2: cosine similarity to cached work / non-work profile embeddings
GATE_TIER2_WORK_SIM_MIN=0.8
GATE_TIER2_NONWORK_SIM_MIN=0.8
GATE_TIER2_PAGE_COUNT=3
# Tier 1 + Tier 3: how many leading pages to join (heuristic + LLM sample)
GATE_HEURISTIC_PAGE_COUNT=10
GATE_LLM_CHAR_LIMIT=9000
# Optional: Ollama model used only for gate Tier 3 (defaults to OLLAMA_MODEL)
OLLAMA_GATE_MODEL=

# PDF OCR — Poppler in backend + PaddleOCR-VL (Hugging Face, GPU in Docker)
ENABLE_PDF_OCR=true
PADDLE_OCR_URL=http://paddle-ocr:8000
PADDLE_OCR_PORT=8008
PADDLE_OCR_ENGINE=vl
PADDLE_OCR_VL_MODEL=PaddlePaddle/PaddleOCR-VL
PADDLE_OCR_TIMEOUT_MS=300000
PDF_OCR_MAX_PAGES=200
PDF_OCR_MANUAL_MAX_PAGES=0
PDF_OCR_AUTO_REINDEX=true
PDF_OCR_INLINE_BEFORE_INDEX=true
PDF_OCR_RENDER_DPI=300
PDF_OCR_SKIP_SHARP_PREPROCESS=true
PDFTOPPM_PATH=
PDFFONTS_PATH=

# PDF vision (§6 Employee 3 — OpenRouter Gemini or Ollama multimodal). On Ollama host:
#   ollama pull llava
# Turn ON for scanned manuals, photos of pages, or diagrams where OCR alone is weak: low-confidence
# or very short OCR text triggers a bounded vision pass (see PDF_VISION_* below).
ENABLE_PDF_VISION=true
# Force vision on pages that likely contain diagrams/figures.
ENABLE_FIGURE_VISION=true
PDF_VISION_MAX_PAGES=180
PDF_VISION_MAX_PAGES_PER_BATCH=20
# ChatGPT-style page explanation before first Qdrant index (after inline OCR when enabled)
PDF_PAGE_EXPLAIN_BEFORE_INDEX=true
# full | concise (default) | transcribe — concise/transcribe use far fewer vision tokens
# For MCC / wiring-only PDFs (all pages unreadable), use full for richer Qdrant text
PDF_PAGE_EXPLAIN_MODE=concise
PDF_PAGE_EXPLAIN_MAX_PAGES=150
PDF_PAGE_EXPLAIN_MIN_CHARS=200
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OLLAMA_VISION_MODEL=llava:latest

# Field photos on knowledge entries — vision description stored in DB and Qdrant
ENABLE_FIELD_PHOTO_VISION=true

# Chat widget: describe user-attached photos with the vision model (§10 Type 2)
ENABLE_CHAT_IMAGE_VISION=true
# Mean OCR confidence (0–1) below this triggers vision follow-up when ENABLE_PDF_VISION=true
PDF_VISION_TRIGGER_OCR_CONFIDENCE_BELOW=0.45
# Also trigger vision if OCR text is shorter than this many characters
PDF_VISION_MIN_OCR_TEXT_CHARS=40
# Force vision on pages whose extracted text contains custom-font/LCD-glyph
# corruption (e.g. ",4#9':+$#':") even when overall text looks fine.
ENABLE_GLYPH_CORRUPTION_VISION=true
# Page window size used for OCR/vision batching across large manuals.
DOC_BATCH_PAGES=20

# PDF structured extraction (LLM candidates + chunk caps)
DOC_EXTRACTION_MAX_CHUNKS=80
# Max number of chunks sent to RAG indexing (chat retrieval coverage).
DOC_INDEX_MAX_CHUNKS=2000
DOC_EXTRACTION_MAX_CANDIDATES=200
DOC_EXTRACTION_MAX_CANDIDATES_PER_CHUNK=10
# Recommended for nomic-embed-text: DOC_EXTRACTION_CHUNK_SIZE=4000, OVERLAP=600
DOC_EXTRACTION_CHUNK_SIZE=12000
DOC_EXTRACTION_CHUNK_OVERLAP=1500
# Skip near-duplicate chunks using token Jaccard similarity (0..1).
DOC_CHUNK_NEAR_DUPLICATE_JACCARD=0.97

# Field photos for knowledge entries (relative to backend cwd)
KNOWLEDGE_PHOTO_UPLOAD_DIR=uploads/knowledge-photos

# WhatsApp Integration (for future phases)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smartmaint.com